# Copy to .env and fill in. Never commit .env.

# --- Database
DATABASE_NAME=howlers
DATABASE_USER=howlers
DATABASE_PASSWORD=change-me-to-a-long-random-string

# --- Auth: base64 of >= 32 random bytes.  Generate:  openssl rand -base64 48
JWT_SECRET=

# --- Public URL the browser uses (emails link here; also the allowed CORS origin)
APP_PUBLIC_URL=http://localhost:8088
WEB_PORT=8088
# true behind HTTPS (production)
COOKIE_SECURE=false

# --- Mail (D-038): "log" prints verification/reset links to the backend log; "brevo" sends through Brevo's API;
# "smtp" sends through any SMTP relay (Brevo's too: smtp-relay.brevo.com:587 with your Brevo SMTP login and SMTP key).
MAIL_MODE=log
# Must be a sender (or on a domain) verified in your Brevo / SMTP provider account.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Howlers
MAIL_REPLY_TO=
BREVO_API_KEY=              # Brevo > SMTP & API > API keys; server-side only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Community AI (optional). Without a key, answers are cited retrieval summaries (offline mode).
# The key stays on the server; it is never sent to the browser.
ANTHROPIC_API_KEY=
AI_MODEL=              # model id from your AI provider; required with an API key
AI_EFFORT=medium

# --- Podcast audio generation (optional, D-036). Without a key the studio says audio generation is unavailable.
# Server-side only. Uses premade voices; override the ids to pick other stock voices.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_A=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_VOICE_B=JBFqnCBsd6RMkjVDRZzb
# TTS_DAILY_CHARACTER_BUDGET=100000

# --- Web push notifications (optional, D-040). Without a key pair, Settings says push isn't set up.
# Generate once: cd backend && ./mvnw -q compile && java -cp target/classes app.howlers.push.VapidKeyGenerator
# (or npx web-push generate-vapid-keys). Server-side; keep the pair stable, changing it drops every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=              # mailto:you@example.com or https://your-site

# --- Object storage (SeaweedFS in docker-compose.yml; any S3-compatible service in production). See docs/DEPLOYMENT.md.
# STORAGE_DRIVER=s3 (default in compose) or local (files in the uploads volume).
STORAGE_DRIVER=s3
# Credentials for the bundled SeaweedFS S3 service (or your own S3 bucket).
S3_ACCESS_KEY=howlers
S3_SECRET_KEY=change-me-to-another-long-random-string
S3_BUCKET=howlers

# --- Secrets that production refuses to start without (prod profile, D-026)
# Salt for hashing share-link visitor IPs:  openssl rand -hex 32
FILE_VISITOR_SALT=
# Demo funding webhook HMAC secret (>= 16 chars):  openssl rand -hex 32
FUNDING_DEMO_WEBHOOK_SECRET=
# Encrypts two-factor (TOTP) secrets at rest (D-042):  openssl rand -base64 32
# Blank outside prod: derived from JWT_SECRET with a warning. Changing it later breaks existing 2FA enrolments.
ACCOUNT_SECRETS_KEY=

# --- Passkeys (D-041). Blank = the host and origin of APP_PUBLIC_URL (localhost works for development).
# WEBAUTHN_RP_ID=howlers.example.com
# WEBAUTHN_ORIGINS=https://howlers.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# --- Moderator funding provider (D-034): demo (simulated money) or stripe (hosted Checkout, test mode)
FUNDING_PROVIDER=demo
# Stripe test keys from the Stripe dashboard (Developers -> API keys). Placeholders only; never commit real keys.
STRIPE_SECRET_KEY=
# Webhook signing secret (dashboard endpoint, or printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# A live key (sk_live_) is refused unless BOTH are set after the compliance review (KYC, payouts, tax, money transmission)
FUNDING_LIVE_MODE=false
FUNDING_COMPLIANCE_ACK=
# Stripe Connect payouts to moderators (D-046, D-047). Needs FUNDING_PROVIDER=stripe and Connect activated in the
# Stripe dashboard. Off: allocations of Stripe pools are held. A live key also needs STRIPE_CONNECT_LIVE=true.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_LIVE=false
STRIPE_CONNECT_COUNTRY=US
# Only if the dashboard has a separate "connected accounts" webhook endpoint with its own signing secret
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Demo content (clearly fictional demo accounts). Set false in production.
SEED_DEMO_DATA=true
# "prod" enables secure cookies and disables seeding by default
SPRING_PROFILES_ACTIVE=default
