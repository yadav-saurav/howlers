# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (chmod 600) and fill in EVERY value.
# Never commit deploy/.env. The backend's prod profile refuses to start with development defaults (D-026).

# --- Public address (DNS must point here; Caddy gets the TLS certificate automatically)
HOWLERS_DOMAIN=howlers.example.com
ACME_EMAIL=ops@example.com

# --- Database
DATABASE_NAME=howlers
DATABASE_USER=howlers
DATABASE_PASSWORD=          # openssl rand -base64 32
DATABASE_POOL_SIZE=15

# --- Redis (rate limits, feed cache)
REDIS_PASSWORD=             # openssl rand -hex 24

# --- Object storage (SeaweedFS in this stack). For AWS S3 instead, see docs/DEPLOYMENT.md.
S3_ACCESS_KEY=howlers
S3_SECRET_KEY=              # openssl rand -hex 32
S3_BUCKET=howlers

# --- Secrets the API refuses to start without
JWT_SECRET=                 # openssl rand -base64 48
FILE_VISITOR_SALT=          # openssl rand -hex 32
FUNDING_DEMO_WEBHOOK_SECRET=  # openssl rand -hex 32
ACCOUNT_SECRETS_KEY=        # openssl rand -base64 32  (encrypts 2FA secrets; keep it with your backups, D-042)

# --- Passkeys (D-041). Blank = derived from HOWLERS_DOMAIN (rp id = the domain, origin = https://the domain).
# Changing the rp id later orphans every registered passkey.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# --- Mail (verification and password-reset links, D-038): brevo (REST API) or smtp (any relay, Brevo's included)
MAIL_MODE=brevo
MAIL_FROM_ADDRESS=no-reply@howlers.example.com   # a sender/domain verified in Brevo
MAIL_FROM_NAME=Howlers
MAIL_REPLY_TO=
BREVO_API_KEY=              # Brevo > SMTP & API > API keys
# For MAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional
ANTHROPIC_API_KEY=          # Community AI; without it, answers are offline cited summaries
AI_MODEL=                   # model id from your AI provider; required with an API key
AI_EFFORT=medium
ELEVENLABS_API_KEY=         # podcast audio generation (D-036); empty = unavailable
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_DAILY_CHARACTER_BUDGET=100000   # characters per community per UTC day
VAPID_PUBLIC_KEY=           # web push (D-040); generate with app.howlers.push.VapidKeyGenerator; empty = unavailable
VAPID_PRIVATE_KEY=          # never commit; keep stable (rotating drops all subscriptions)
VAPID_SUBJECT=              # mailto:ops@howlers.example.com
FUNDING_ENABLED=true        # moderator funding (D-022)
FUNDING_PROVIDER=demo       # demo, or stripe (hosted Checkout, D-034)
STRIPE_SECRET_KEY=          # sk_test_... ; never commit. A live key needs the two settings below
STRIPE_WEBHOOK_SECRET=      # whsec_... from the dashboard endpoint .../api/v1/funding/webhooks/stripe
FUNDING_LIVE_MODE=false     # true only after the compliance review (D-034)
FUNDING_COMPLIANCE_ACK=     # who signed off KYC, payouts, tax and money-transmission review, and when
STRIPE_CONNECT_ENABLED=false  # Connect payouts to moderators (D-046); needs Connect activated in the Stripe dashboard
STRIPE_CONNECT_LIVE=false     # a live key also needs this (D-047), on top of the two settings above
STRIPE_CONNECT_COUNTRY=US     # country new Express accounts are created in
STRIPE_CONNECT_WEBHOOK_SECRET=  # whsec_... of a separate "connected accounts" endpoint, if you made one
SEED_DEMO_DATA=false        # never true for a real community
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
GRAFANA_ADMIN_PASSWORD=     # only with --profile monitoring
# Prebuilt images (CI) instead of building on the server:
# HOWLERS_BACKEND_IMAGE=ghcr.io/your-org/howlers-backend:1.2.3
# HOWLERS_WEB_IMAGE=ghcr.io/your-org/howlers-web:1.2.3
